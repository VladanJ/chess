{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Play vs AI",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/ChessGame.py",
            "args": [],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Train AI (self-play)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/train.py",
            "args": ["--games", "${input:trainGames}"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ],
    "inputs": [
        {
            "id": "trainGames",
            "type": "promptString",
            "description": "Number of self-play training games",
            "default": "1000"
        }
    ]
}
