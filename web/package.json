{
  "name": "realtime-chess-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "train": "esbuild tools/train.ts --bundle --platform=node --format=esm --outfile=tools/.train.mjs --log-level=warning && node tools/.train.mjs",
    "test": "esbuild tests/*.test.ts --bundle --platform=node --format=esm --outdir=tests/.out --log-level=warning && node --test tests/.out/*.test.js",
    "dev:crazygames": "vite --mode crazygames",
    "dev:poki": "vite --mode poki",
    "build:crazygames": "tsc --noEmit && vite build --mode crazygames",
    "build:poki": "tsc --noEmit && vite build --mode poki"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "typescript": "^5.6.0",
    "vite": "^6.4.5"
  }
}
